# ============================================================
# Lumina V3 — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# -- App --
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-random-64-chars
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:5173"]

# -- Database --
DATABASE_URL=postgresql+asyncpg://lumina:lumina@localhost:5432/lumina
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# -- Redis --
REDIS_URL=redis://localhost:6379/0

# -- Telegram --
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_WEBHOOK_SECRET=change-me-to-random-32-chars
TELEGRAM_WEBHOOK_URL=https://your-domain.com/bot/webhook
TELEGRAM_MINI_APP_URL=https://your-domain.com

# -- Auth --
AUTH_TOKEN_EXPIRE_MINUTES=1440
AUTH_INIT_DATA_EXPIRE_SECONDS=300

# -- AI (optional, graceful degradation) --
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1

# -- File Storage --
FILE_STORAGE_PATH=./storage/files
FILE_MAX_SIZE_MB=50

# -- Background Workers --
WORKER_CONCURRENCY=10
